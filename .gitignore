# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/

# Virtual environments
venv/
venv_stable/
.venv/

# API keys and secrets
.env
.env.local

# Audio files (too large for git)
*.mp3
*.m4a
*.wav
*.flac
*.ogg
audio_chapters/
audio_chapters_english/

# Data folders (keep structure, ignore contents)
data/input/icelandic/*
data/input/english/*
data/output/**
data/databases/*.db
data/databases/*.db-*

# Book folders (audio, transcripts, databases)
data/books/*/audio/*
data/books/*/learner.db
data/books/*/learner.db-*
# Book text stays local (copyrighted, repo is public)
data/books/*/transcripts/
data/books/*/backup/
data/books/*/markdown/

# Keep directory structure and chapter mappings
!data/**/.gitkeep
!data/**/README.md
!data/books/*/chapter_mapping.json

# Logs
logs/*
!logs/.gitkeep

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Tool configs
.claude/

# Misc
*.log
v1_backup/
